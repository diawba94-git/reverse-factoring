@partenaireId = {{creerPartenaire.response.body.$.id}}

### Statut KYC initial attendu : "en_attente". L'admin fait passer les 3 entreprises a "valide"
### (necessaire notamment pour la section 3.1 ANNEXE I, qui exige une entreprise KYC-validee
### pour pouvoir inviter) :

PATCH {{baseUrl}}/entreprises/{{pmeId}}/kyc
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "statut_kyc": "valide"
}

###
PATCH {{baseUrl}}/entreprises/{{donneurId}}/kyc
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "statut_kyc": "valide"
}

###
PATCH {{baseUrl}}/entreprises/{{partenaireId}}/kyc
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "statut_kyc": "valide"
}

### =====================================================================
### 3. INSCRIPTION DES UTILISATEURS (usage interne/admin, /auth/register)
