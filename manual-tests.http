  "secteur_activite": "Agroalimentaire",
  "date_creation": "2020-01-15",
  "contact_telephone": "+221771111111",
  "contact_email": "contact@senegalfruits.sn"
}

###
@pmeId = {{creerPme.response.body.$.id}}

