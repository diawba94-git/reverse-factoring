# Postgres
POSTGRES_USER=invoiceup
POSTGRES_PASSWORD=change_me
POSTGRES_DB=invoiceup
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL used by the backend (host "db" = docker-compose service name).
# If running the backend outside docker-compose, replace "db" with "localhost".
DATABASE_URL=postgresql+psycopg2://invoiceup:change_me@db:5432/invoiceup

# Redis (reserved for Celery in a later phase)
REDIS_URL=redis://redis:6379/0

# Auth / JWT
SECRET_KEY=replace_with_a_long_random_hex_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA
MFA_ISSUER_NAME=InvoiceUp

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:5173

# Wave webhook (stub for this phase)
WAVE_WEBHOOK_SECRET=replace_with_wave_webhook_secret
